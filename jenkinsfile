pipeline {
    agent {
        docker {
            image 'cypress/included:14.5.4'
            args '-u root --entrypoint='
        }
    }

    parameters {
        booleanParam(
            name: 'ALLURE',
            defaultValue: false,
            description: 'Générer le rapport Allure'
        )

        choice(
            name: 'TAGS',
            choices: ['Tous', '@E2E', '@achat'],
            description: 'Choisir le tag'
        )
    }

    stages {

        stage('Installation') {
            steps {
                sh 'npm ci'
            }
        }

        stage('Tests Cypress') {
            steps {
                script {
                    if (params.TAGS == 'Tous') {
                        sh 'npx cypress run'
                    } else {
                        sh "npx cypress run --env grepTags=${params.TAGS}"
                    }
                }
            }
        }

        stage('Allure') {
            when {
                expression { params.ALLURE }
            }
            steps {
                sh 'npx allure generate allure-results --clean -o allure-report'
            }
        }
    }

    post {
        always {
            script {
                if (params.ALLURE) {
                    allure(
                        includeProperties: false,
                        jdk: '',
                        results: [[path: 'allure-results']]
                    )
                }
            }
        }
    }
}