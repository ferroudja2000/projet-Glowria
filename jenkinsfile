```groovy
pipeline {

    agent any

    parameters {

        booleanParam(
            name: 'GENERATE_ALLURE',
            defaultValue: false,
            description: 'Activer la génération du rapport Allure'
        )
    }

    stages {

        stage('Tests Cypress') {

            agent {
                docker {
                    image 'cypress/included:14.5.4'
                    args '-u root --entrypoint='
                }
            }

            stages {

                stage('Installation') {
                    steps {
                        sh 'npm ci'
                    }
                }

                stage('Préparation') {
                    steps {
                        sh '''
                            rm -rf allure-results
                            rm -rf allure-report
                            rm -rf cypress/reports

                            mkdir -p allure-results
                        '''
                    }
                }

                stage('Tests') {
                    steps {
                        script {

                            try {

                                if (params.GENERATE_ALLURE) {

                                    echo 'Allure activé'

                                    sh '''
                                        npx cypress run --env allure=true
                                    '''

                                } else {

                                    echo 'Allure désactivé'

                                    sh '''
                                        npx cypress run
                                    '''
                                }

                            } finally {

                                echo 'Les tests Cypress sont terminés.'
                            }
                        }
                    }
                }
            }
        }
    }

    post {

        always {

            script {

                echo 'Archivage des rapports...'

                archiveArtifacts(
                    artifacts: '''
                        cypress/reports/**
                        ,allure-results/**
                        ,allure-report/**
                        ,cypress/screenshots/**
                        ,cypress/videos/**
                    ''',
                    allowEmptyArchive: true
                )

                /*
                 * Publication Allure uniquement
                 * si la case GENERATE_ALLURE est cochée.
                 */
                if (params.GENERATE_ALLURE) {

                    echo 'Publication du rapport Allure...'

                    allure(
                        includeProperties: false,
                        jdk: '',
                        results: [
                            [path: 'allure-results']
                        ]
                    )
                }

            }
        }
    }
}
```
