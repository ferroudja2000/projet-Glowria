pipeline {

    agent any

    parameters {
        booleanParam(
            name: 'GENERATE_ALLURE',
            defaultValue: false,
            description: 'Activer le rapport Allure'
        )
    }

    stages {

        stage('Tests Cypress') {
            agent {
                docker {
                    image 'cypress/included:14.5.4'
                    args '-u root --entrypoint='
                }
            }
            stages {
                stage('Installation') {
                    steps {
                        sh 'npm ci'
                    }
                }
                stage('Préparation') {
                    steps {
                        sh 'rm -rf allure-results'
                    }
                }

                stage('Tests') {
                    steps {
                        script {
                            if (params.GENERATE_ALLURE) {
                                sh 'npx cypress run --env allure=true'
                            } else {
                                sh 'npx cypress run'
                            }
                        }
                      }
                 }
             }
             }
       }

    post {
        always {
            script {
                if (params.GENERATE_ALLURE) {
                    allure(
                        includeProperties: false,
                        jdk: '',
                        results: [
                            [path: 'allure-results']
                        ]
                      )
                 }
                   }
          }
          }
           }
