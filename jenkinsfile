pipeline {

    agent {
        docker {
            image 'cypress/included:14.5.4'
            args '-u root --entrypoint='
        }
    }

    stages {

        stage('Installation') {
            steps {
                sh 'npm ci'
            }
        }

        stage('Tests Cypress') {
            steps {
                sh 'npx cypress run'
            }
        }
    }
}