pipeline {

    agent any

    parameters {

        booleanParam(
            name: 'ALLURE',
            defaultValue: false,
            description: 'Génération du rapport Allure'
        )

        booleanParam(
            name: 'ISTAGS',
            defaultValue: false,
            description: 'Exécuter avec ou sans tags'
        )

        choice(
            name: 'TAGS',
            choices: ['@E2E @achat', '@inscription'],
            description: 'Choisissez le tag'
        )
    }

    stages {

        stage('Tests Cypress') {

            agent {
                docker {
                    image 'cypress/included:14.5.4'
                    args '-u root --entrypoint='
                }
            }

            stages {

                stage('Installation') {
                    steps {
                        sh 'npm ci'
                    }
                }

                stage('Clean Allure Results') {
                    steps {
                        sh '''
                            rm -rf allure-results
                            rm -rf allure-report
                            mkdir -p allure-results
                        '''
                    }
                }

                stage('Tests') {
                    steps {
                        script {

                            if (params.ISTAGS) {
                                sh "npx cypress run --env grepTags=${params.TAGS}"
                            } else {
                                sh "npx cypress run"
                            }

                        }
                    }
                }

                stage('Generate Allure Report') {
                    when {
                        expression {
                            params.ALLURE
                        }
                    }

                    steps {
                        sh '''
                            npx allure generate allure-results \
                            --clean \
                            -o allure-report
                        '''
                    }
                }
            }
        }
    }

    post {

        always {

            script {

                if (params.ALLURE) {

                    archiveArtifacts(
                        artifacts: 'allure-results/**/*,allure-report/**/*',
                        allowEmptyArchive: true
                    )

                    allure(
                        includeProperties: false,
                        jdk: '',
                        results: [
                            [path: 'allure-results']
                        ]
                    )
                }
            }
        }
    }
}