pipeline {

    agent {
        docker {
            image 'cypress/included:14.5.4'
            args '-u root --entrypoint='
        }
    }

    parameters {

        booleanParam(
            name: 'ALLURE',
            defaultValue: false,
            description: 'Générer le rapport Allure'
        )

        booleanParam(
            name: 'MOCHAWESOME',
            defaultValue: true,
            description: 'Générer le rapport Mochawesome'
        )
    }

    stages {

        stage('Installation') {
            steps {
                sh 'npm ci'
            }
        }

        stage('Préparation des rapports') {
            steps {
                script {

                    if (params.ALLURE) {
                        sh '''
                            rm -rf allure-results allure-report
                            mkdir -p allure-results
                        '''
                    }

                    if (params.MOCHAWESOME) {
                        sh '''
                            rm -rf cypress/reports
                            mkdir -p cypress/reports
                        '''
                    }
                }
            }
        }

        stage('Tests Cypress') {
            steps {
                script {
                    sh 'npx cypress run'
                }
            }
        }
    }

    post {

        always {
            script {

                // =========================
                // ARCHIVER LES RAPPORTS
                // =========================

                if (params.MOCHAWESOME) {
                    archiveArtifacts(
                        artifacts: 'cypress/reports/**',
                        allowEmptyArchive: true
                    )
                }

                // =========================
                // ALLURE
                // =========================

                if (params.ALLURE) {

                    echo 'Génération du rapport Allure...'

                    try {
                        allure(
                            results: [
                                [path: 'allure-results']
                            ]
                        )
                    } catch (Exception e) {
                        echo "Impossible de générer Allure : ${e.message}"
                    }
                }

                // =========================
                // MOCHAWESOME
                // =========================

                if (params.MOCHAWESOME) {
                    echo 'Rapport Mochawesome disponible dans cypress/reports/'
                }
            }
        }
    }
}